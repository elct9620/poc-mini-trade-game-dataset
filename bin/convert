#!/usr/bin/env ruby
# frozen_string_literal: true

# link:docs/features/conversion.md
# Command-line tool to convert a dataset CSV into chat-format JSONL for fine-tuning.

require 'optparse'
require_relative '../lib/dataset'
require_relative '../lib/conversion'

usage = 'Usage: bundle exec ruby bin/convert path/to/input.csv -o path/to/output.jsonl'
output_path = nil

OptionParser.new do |opts|
  opts.banner = usage
  opts.on('-o', '--output PATH', 'JSONL file to write') { |path| output_path = path }
end.parse!

input_path = ARGV[0]

if input_path.nil? || output_path.nil?
  puts usage
  exit 1
end

unless File.exist?(input_path)
  puts "Error: File '#{input_path}' not found"
  exit 1
end

File.open(output_path, 'w') do |file|
  Conversion.new(Dataset.new(input_path), file).execute
end
